# Local development ONLY. Copy to backend/.env, which is ignored by Git.
# API, Alembic and Worker read this file; environment variables take precedence.
APP_MODE=mock
APP_TEST_ONLY=true
APP_DATABASE_URL=mysql+pymysql://ecommerce_dev:TEST_ONLY_dev_local@127.0.0.1:13306/ecommerce_ai_dev?charset=utf8mb4
APP_REDIS_URL=redis://127.0.0.1:16379/0
# Use an absolute, writable persistent directory. Create it before API startup.
APP_STORAGE_ROOT=F:/Work/电商/web/.local-data/storage
APP_STORAGE_PERSISTENT=true
# Set the actual HTTPS frontend origin before using authenticated write operations.
APP_AUTH_ORIGINS=[]
# New text tasks use the DB service connection and explicit default model from Admin.
# Legacy named profiles are optional ONLY for previously admitted legacy tasks.
APP_TEXT_AGENT_PROFILES={}
# Match textAgent max_concurrent_per_client; shared across all local Worker processes.
APP_TEXT_GENERATION_CONCURRENCY=6
# Async task quotas are held through execution, shared across all Web workers.
APP_IMAGE_GENERATION_CONCURRENCY=6
# Current videoAgent runs a singleton worker; waiting for user input frees planning capacity.
APP_VIDEO_GENERATION_CONCURRENCY=1
# Service address and access Key are saved in the web DB through Admin > Agents > Text.
# Set one persistent Fernet master key before saving; never commit its real value.
# APP_TEXT_SERVICE_ENCRYPTION_KEY=REPLACE_WITH_A_GENERATED_FERNET_KEY
