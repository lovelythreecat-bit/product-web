# Local development ONLY. Never copy these TEST_ONLY values into staging/production.
APP_MODE=mock
APP_TEST_ONLY=true
APP_DATABASE_URL=mysql+pymysql://ecommerce_dev:TEST_ONLY_dev_local@127.0.0.1:13306/ecommerce_ai_dev?charset=utf8mb4
APP_REDIS_URL=redis://127.0.0.1:16379/0
# Set an absolute path on a persistent disk; provision it before starting the API.
# APP_STORAGE_ROOT=F:/Work/电商/web/.local-data/storage
APP_STORAGE_PERSISTENT=false

# Opt in to real integration tests. Never point this at any other database.
TEST_DATABASE_URL=mysql+pymysql://ecommerce_test:TEST_ONLY_test_local@127.0.0.1:13306/ecommerce_ai_test?charset=utf8mb4
TEST_REDIS_URL=redis://127.0.0.1:16379/15
TEST_ONLY=true

# Optional: bind only to the current WSL private address if localhost forwarding is unavailable.
DEV_BIND_ADDRESS=127.0.0.1
# Vite may use API_PROXY_TARGET for a different API address. Never expose credentials via VITE_*.
